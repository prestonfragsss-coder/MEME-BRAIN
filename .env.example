# Required
ANTHROPIC_API_KEY=                # or `ant auth login`
# Optional integrations (missing ones become explicit BLOCKED tasks, never fake output)
HERMES_IMAGE_SOURCE=auto            # auto: API if OPENAI_API_KEY set, else ChatGPT import. Or: api / chatgpt
OPENAI_API_KEY=                   # OpenAI API billing (platform.openai.com) - a ChatGPT Plus/Pro plan does NOT include this
NETLIFY_AUTH_TOKEN=               # website deployment
# Tuning
HERMES_LAUNCHES_DIR=./launches
HERMES_MODEL=claude-opus-5-5
HERMES_IMAGE_MODEL=gpt-image-1
HERMES_SCORE_THRESHOLD=80
